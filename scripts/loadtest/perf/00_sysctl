#!/bin/sh
# Allow perf to see kernel symbols and to profile without privileges.
#
# perf_event_paranoid=-1  lifts the restriction on what perf may observe
# kptr_restrict=0         exposes kernel pointers, without which kernel frames in
#                         a stack collapse into one unresolved address
#
# Both weaken the machine's isolation and are appropriate on a loadtest VM only.
# Neither is persisted: a reboot restores the defaults.

set -e

if [ "$(id -u)" -ne 0 ]; then
	echo "$(basename "$0"): must run as root" >&2
	exit 1
fi

sysctl --load=- <<EOF
kernel.perf_event_paranoid=-1
kernel.kptr_restrict=0
EOF
