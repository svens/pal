#!/bin/sh
# Turn the recording from 01_run into a flame graph.
#
# usage: 02_report <name>
#
# Reads ./perf.data and writes ./perf_<name>.svg. Requires FlameGraph's
# stackcollapse-perf.pl and flamegraph.pl on PATH:
#
#   git clone https://github.com/brendangregg/FlameGraph
#   PATH=$PATH:$PWD/FlameGraph
#
# A flame graph answers "where did the CPU go", which for a relay is usually a
# split between syscall entry, the socket layer, and session lookup. It does not
# answer "why were packets dropped" -- that is what host/counters is for.

set -e

name=$1
if [ -z "$name" ]; then
	echo "usage: $(basename "$0") <name>" >&2
	exit 2
fi

if [ ! -r perf.data ]; then
	echo "no perf.data here: run 01_run first" >&2
	exit 1
fi

for tool in stackcollapse-perf.pl flamegraph.pl; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		echo "$tool not on PATH: see the comment in $(basename "$0")" >&2
		exit 1
	fi
done

perf script | stackcollapse-perf.pl | flamegraph.pl > "perf_${name}.svg"
echo "wrote perf_${name}.svg"
