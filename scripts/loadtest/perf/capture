#!/bin/sh
## Record samples and syscall counts over one window
## see docs/profile.md, Capture
#
# usage: capture <seconds> <name> <hz>
#
# Leaves perf-<name>.data and perf-<name>.syscalls beside this script. Sampling is
# system-wide: softirq is a third of this machine's busy time and no per-process
# profile sees it. --call-graph fp needs the profile build, which 'ship' puts here
# when pointed at .build/linux-gcc-profile.
#
# The syscall counts come from tracepoints rather than hardware counters, so they
# work on a guest with no virtual PMU. Datagrams per syscall is computed from these
# counts and the window's 'host/counters delta'.

set -e

seconds=$1
name=$2
hz=$3

if [ -z "$seconds" ] || [ -z "$name" ] || [ -z "$hz" ]; then
	echo "usage: $(basename "$0") <seconds> <name> <hz>" >&2
	exit 2
fi

if [ "$(id -u)" -ne 0 ]; then
	echo "$(basename "$0"): must run as root" >&2
	exit 1
fi

cd "$(dirname "$0")"

perf stat --all-cpus \
	-e syscalls:sys_enter_recvmmsg \
	-e syscalls:sys_enter_sendmmsg \
	-e syscalls:sys_enter_recvmsg \
	-e syscalls:sys_enter_sendmsg \
	-e syscalls:sys_enter_epoll_pwait2 \
	-- sleep "$seconds" > "perf-${name}.syscalls" 2>&1 &

perf record --all-cpus --freq "$hz" --call-graph fp --output "perf-${name}.data" -- sleep "$seconds"
wait

if [ -n "$SUDO_USER" ]; then
	chown "$SUDO_USER" "perf-${name}.data" "perf-${name}.syscalls"
fi
echo "wrote $(pwd)/perf-${name}.data and perf-${name}.syscalls"
