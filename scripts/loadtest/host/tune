#!/bin/sh
## every tuning stage, in packet-path order
## see docs/tune_linux.md, Using these scripts
#
# The order is a property of the stages, so it is listed here rather than globbed:
# rings are sized before the coalescing window that depends on them, and both
# precede XPS for a driver that reallocates its queues on resize. mlx5 does not.
#
# A stage that fails does not stop the rest. The exit status is nonzero if any of
# them failed.

. "$(dirname "$0")/_common.sh"
require_verb show apply

here=$(dirname "$0")
failed=""

for stage in 00_boot 01_cpu 02_ethtool_hash 02_ethtool_ring 02_ethtool_coalesce 03_irq 05_sysctl 06_xps 07_qdisc; do
	echo
	echo "== $stage $verb"
	"$here/$stage" "$verb" || failed="${failed} $stage"
done

if [ -n "$failed" ]; then
	echo
	echo "failed:${failed}" >&2
	exit 1
fi
