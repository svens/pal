#!/bin/sh
## kernel networking stack -- queue and buffer sizes
## see docs/tune_linux.md, 7 Kernel queues and buffers

. "$(dirname "$0")/_common.sh"
require_verb show apply

# What apply writes, and what show compares against, so the two cannot describe
# different tunings. A knob absent here is reported and never written.
targets="
net.core.netdev_max_backlog=30000
net.core.netdev_budget=600
net.core.netdev_budget_usecs=8000
net.core.rmem_max=$((8 * 1024 * 1024))
net.core.wmem_max=$((8 * 1024 * 1024))
net.core.rmem_default=$((2 * 1024 * 1024))
net.core.wmem_default=$((2 * 1024 * 1024))
net.ipv4.udp_rmem_min=$((256 * 1024))
"

names="
net.core.netdev_max_backlog
net.core.netdev_budget
net.core.netdev_budget_usecs
net.core.rmem_max
net.core.wmem_max
net.core.rmem_default
net.core.wmem_default
net.core.busy_poll
net.core.busy_read
net.ipv4.udp_mem
net.ipv4.udp_rmem_min
"

for name in $names; do
	current=$(sysctl -n "$name" 2>/dev/null || echo '<unavailable>')
	target=$(echo "$targets" | sed -n "s|^${name}=||p")
	if [ -z "$target" ]; then
		report "$name" "$current"
	elif [ "$current" = "$target" ]; then
		report "$name" "$current (what apply would set)"
	else
		report "$name" "$current -> $target"
	fi
done

# The other half of the ceiling: what a running process actually got. The kernel
# stores twice what SO_RCVBUF asked for, so rb at twice rmem_max is a request
# that either reached the ceiling and was reduced, or asked for exactly it --
# indistinguishable from here, which is why the ceilings above are set higher
# than anything these samples ask for. Equality then means the first case.
rmem_max=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
wmem_max=$(sysctl -n net.core.wmem_max 2>/dev/null || echo 0)
sockets=$(ss -lunmp 2>/dev/null | awk '
	/skmem:/ && label != "" {
		rb = ""
		tb = ""
		if (match($0, /rb[0-9]+/)) rb = substr($0, RSTART + 2, RLENGTH - 2)
		if (match($0, /tb[0-9]+/)) tb = substr($0, RSTART + 2, RLENGTH - 2)
		if (rb != "" && tb != "") print label, rb, tb
		label = ""
		next
	}
	$1 != "State" {
		label = $4
		if (match($0, /users:\(\("[^"]+"/)) {
			split($0, parts, "\"")
			label = parts[2]
		}
	}
' | sort -u)

if [ -z "$sockets" ]; then
	report "socket" "nothing has a UDP socket bound; start the relay to see what it got"
else
	echo "$sockets" | while read -r process rb tb; do
		note=""
		if [ "$rb" -eq $((rmem_max * 2)) ]; then
			note="${note} (rb reached rmem_max: asked for more, got this)"
		fi
		if [ "$tb" -eq $((wmem_max * 2)) ]; then
			note="${note} (tb reached wmem_max: asked for more, got this)"
		fi
		report "socket.$process" "rb $rb tb $tb$note"
	done
fi

if [ "$verb" = apply ]; then
	require_root
	echo "$targets" | sysctl --load=- > /dev/null

	# Re-read every one of them. A name the kernel does not have is skipped by
	# sysctl with a message and a nonzero exit that --load swallows, so the
	# written value is the only evidence that it took.
	echo
	for pair in $targets; do
		name=${pair%%=*}
		verify "$name" "${pair#*=}" "$(sysctl -n "$name" 2>/dev/null)"
	done
	verify_exit
fi
