#!/bin/sh
## Receive Packet Steering -- deliberately not enabled
## see docs/tune_linux.md, 6 Software receive steering

. "$(dirname "$0")/_common.sh"
require_verb show apply

nic=$(get_nic)
report "nic" "$nic"
report "cpus" "$(nproc --all)"

queues=$(ls -d "/sys/class/net/${nic}/queues"/rx-* 2>/dev/null | wc -l)
report "rx queues" "$queues"
report "rps_sock_flow_entries" "$(cat /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null || echo '<unavailable>')"

for queue in "/sys/class/net/${nic}/queues"/rx-*; do
	[ -d "$queue" ] || continue
	report "$(basename "$queue") rps_cpus" "$(cat "${queue}/rps_cpus" 2>/dev/null)"
done

if [ "$verb" = apply ]; then
	echo
	echo "nothing applied: RPS is not used on this setup, see the comment in $0"
fi
