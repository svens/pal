ninja_required_version = 1.1

# Standalone on purpose: nothing at repository level references this file, and
# it references nothing there. Run it from this directory, which is what the
# action paths below are relative to.

rule action
  command = cmake -P azure/$name.cmake
  description = $name
  pool = console

rule relay
  command = cmake -Dhost=$host -P azure/${name}-relay.cmake
  description = $name $host
  pool = console

build help: action
  name = help

build validate: action
  name = validate

build deploy: action
  name = deploy

build show: action
  name = show

build config: action
  name = config

build start: action
  name = start

build stop: action
  name = stop

build deallocate: action
  name = deallocate

build destroy: action
  name = destroy

build ship: action
  name = ship

build tune: action
  name = tune

build start-relay-linux: relay
  name = start
  host = relay-linux

build start-relay-windows: relay
  name = start
  host = relay-windows

build stop-relay-linux: relay
  name = stop
  host = relay-linux

build stop-relay-windows: relay
  name = stop
  host = relay-windows

build run: action
  name = run

build sweep: action
  name = sweep

default help
